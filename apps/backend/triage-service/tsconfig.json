{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2021",
    "sourceMap": true,
    "outDir": "../../../dist/out-tsc",
    "incremental": true,
    "strict": true,
    "types": ["jest", "node"]
  },
  "exclude": ["node_modules", "dist"]
}
