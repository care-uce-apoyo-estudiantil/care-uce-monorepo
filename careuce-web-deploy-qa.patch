diff --git a/apps/care-uce-web/Dockerfile b/apps/care-uce-web/Dockerfile
new file mode 100644
index 0000000..70674ea
--- /dev/null
+++ b/apps/care-uce-web/Dockerfile
@@ -0,0 +1,19 @@
+# Etapa 1: Construcción (mismo patrón que los microservicios backend)
+FROM node:22-alpine AS builder
+WORKDIR /app
+COPY package*.json ./
+RUN npm install --legacy-peer-deps
+COPY . .
+# Construimos solo el frontend web usando Nx (target "build" del plugin @nx/vite,
+# inferido automáticamente; vite build ya genera un bundle de producción por defecto)
+RUN npx nx build care-uce-web
+
+# Etapa 2: Servir los estáticos con Nginx
+FROM nginx:alpine
+# Config propia del contenedor web (SPA fallback), NO la del API Gateway
+COPY apps/care-uce-web/nginx.conf /etc/nginx/conf.d/default.conf
+COPY --from=builder /app/apps/care-uce-web/dist /usr/share/nginx/html
+
+EXPOSE 80
+
+CMD ["nginx", "-g", "daemon off;"]
diff --git a/apps/care-uce-web/nginx.conf b/apps/care-uce-web/nginx.conf
new file mode 100644
index 0000000..0a48093
--- /dev/null
+++ b/apps/care-uce-web/nginx.conf
@@ -0,0 +1,19 @@
+server {
+    listen 80;
+    server_name _;
+    root /usr/share/nginx/html;
+    index index.html;
+
+    # SPA: cualquier ruta que no sea un archivo estático cae a index.html
+    # (React Router maneja el enrutamiento en el cliente)
+    location / {
+        try_files $uri $uri/ /index.html;
+    }
+
+    # Cache agresivo para assets versionados por Vite (hash en el nombre)
+    location /assets/ {
+        try_files $uri =404;
+        expires 1y;
+        add_header Cache-Control "public, immutable";
+    }
+}
